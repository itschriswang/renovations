---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Figure from '../components/Figure.astro';
import HeroSequence from '../components/HeroSequence.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { business } from '../lib/business';
import { href, routes } from '../lib/links';
import { band, compact, weeks } from '../lib/format';
import { localBusinessSchema, websiteSchema } from '../lib/schema';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const bands = business.costBands.bands;
const stages = business.process.stages;
const suburbs = business.serviceArea.suburbs;
---

<Site
  title={`${business.identity.name} — renovation builder, Sydney`}
  description={business.identity.positioning}
  image={href("/og/home.png")}
  imageAlt="Stonelane Renovations — fixed price before demolition starts"
  schema={[localBusinessSchema(), websiteSchema()]}
>
  <!-- ================================================================ hero -->
  <section class="hero glow grid-editorial">
    <div class="col-wide hero__text">
      <p class="hero__kicker">
        <span class="stamp">Kitchens</span>
        <span class="stamp stamp--ochre">Bathrooms</span>
        <span class="stamp">Extensions</span>
        <span class="stamp stamp--ochre">Whole homes</span>
      </p>
      <h1 class="hero__title">
        A fixed price <span class="hero__hot">before</span> the first wall comes down
      </h1>
      <p class="hero__lede">{business.identity.differentiatorLong}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={href(routes.contact)}>
          Book a site consultation
        </a>
        <a class="button button--secondary" href={href(routes.estimator)}>
          Work out a rough cost
        </a>
      </div>
    </div>

    <div class="col-bleed hero__figure">
      <HeroSequence
        id="home-hero-sequence"
        alt="A rear extension at dusk, interior lights on, opening onto a back garden"
      />
    </div>
  </section>

  <TrustStrip />

  <!-- ======================================================= what we do -->
  <section class="grid-editorial section">
    <div class="col-text">
      <p class="section__eyebrow">What we do</p>
      <h2 class="section__title">Ordinary Sydney houses, done properly</h2>
      <p class="section__lede">{business.identity.positioning}</p>
    </div>
    <div class="col-aside stat">
      <p class="stat__value" data-numeric>
        {band(business.projectValue.minimum, business.projectValue.maximum)}
      </p>
      <p class="stat__label">
        The range our work falls in. Under {compact(business.projectValue.minimum)} we will point
        you to someone better suited.
      </p>
    </div>
  </section>

  <!-- ============================================================ costs -->
  <section class="grid-editorial section surface-wash-teal">
    <div class="col-text">
      <p class="section__eyebrow">What it costs</p>
      <h2 class="section__title">The bands our work actually falls in</h2>
      <p class="section__lede">
        Published, not hidden behind a form. Price opacity is the main reason people give up
        on renovating, and a builder who will not talk about money until you are in the room
        is telling you something.
      </p>
    </div>

    <ul class="col-wide bands" role="list">
      {
        bands.map((b) => (
          <li class="bands__item" data-reveal>
            <a class="bands__link" href={`${href(routes.costs)}#${b.id}`}>
              <span class="bands__name">{b.name}</span>
              <span class="bands__range" data-numeric>
                {band(b.low, b.high)}
              </span>
              <span class="bands__weeks" data-numeric>
                {weeks(b.typicalWeeks)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="col-text bands__note">
      GST inclusive. Indicative only — the number that matters is the fixed price quote, and we
      cannot give you that until we have measured the house.{' '}
      <a href={href(routes.costs)}>See what moves each band</a>.
    </p>
  </section>

  <!-- ======================================================== approvals -->
  <section class="grid-editorial section section--ruled">
    <div class="col-half">
      <p class="section__eyebrow">Approvals</p>
      <h2 class="section__title">When you need council, and when you do not</h2>
      <p class="section__lede">
        A great deal of work on a standard lot never goes near a council. It is approved by a
        private certifier in weeks under the state codes. Knowing which pathway your block
        qualifies for changes your budget and your timeline more than any other single fact.
      </p>
      <p class="link-more">
        <a href={href(routes.approvals)}>Read the approvals explainer</a>
      </p>
    </div>
    <div class="col-half-end">
      <Figure
        id="approvals-opener"
        alt="A standard suburban lot photographed from the street with the side setbacks visible either side of the house"
        sizes="(min-width: 48rem) 45vw, 92vw"
      />
    </div>
  </section>

  <!-- ========================================================== process -->
  <section class="grid-editorial section surface-sunk">
    <div class="col-text">
      <p class="section__eyebrow">How it runs</p>
      <h2 class="section__title">Eleven stages, and what you own at each</h2>
      <p class="section__lede">
        Renovation buyers fear chaos more than cost. Here is the whole sequence, with real
        durations and an explicit note of what is yours to do — because a job stalls on
        decisions far more often than it stalls on trades.
      </p>
    </div>
    <ol class="col-wide stages" role="list">
      {
        stages.slice(0, 6).map((s) => (
          <li class="stages__item" data-reveal>
            <span class="stages__name">{s.name}</span>
            <span class="stages__duration" data-numeric>
              {s.duration}
            </span>
          </li>
        ))
      }
      <li class="stages__item stages__item--more">
        <a href={href(routes.process)}>and five more →</a>
      </li>
    </ol>
  </section>

  <!-- ========================================================= projects -->
  <section class="grid-editorial section section--ruled">
    <div class="col-text">
      <p class="section__eyebrow">Recent work</p>
      <h2 class="section__title">Three jobs, including what went wrong</h2>
      <p class="section__lede">
        Every case study names the constraint, the decision, one honest problem and what it
        cost the client to fix. That last number is nothing in all three, because that is what
        a fixed price contract means.
      </p>
    </div>
    <div class="col-wide projects">
      {projects.map((p) => <div data-reveal><ProjectCard project={p} /></div>)}
    </div>
  </section>

  <!-- ========================================================== suburbs -->
  <section class="grid-editorial section surface-sunk">
    <div class="col-text">
      <p class="section__eyebrow">Where we work</p>
      <h2 class="section__title">Thirteen suburbs, six councils</h2>
      <p class="section__lede">
        We stay inside an area we can service properly. Each suburb has its own page with the
        housing stock, the council notes and what actually complicates a renovation there.
      </p>
    </div>
    <ul class="col-wide suburbs" role="list">
      {
        suburbs.map((s) => (
          <li>
            <a href={href(routes.suburb(s.slug))}>{s.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <CallToAction />
</Site>

<style>
  /*
   * Light. The hero was a near-black band the height of the viewport, and it
   * set the temperature for the whole site — every page under it then had to
   * be dark to match. It is now paper with a warm bloom behind it, which is
   * where the energy comes from instead.
   */
  .hero {
    padding-block: var(--space-l) var(--space-xl);
    row-gap: var(--space-m);
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-end: var(--space-s);
  }

  .hero__title {
    font-size: var(--text-display-l);
    line-height: 0.98;
    letter-spacing: -0.032em;
    max-width: 15ch;
    margin-block: 0 var(--space-m);
  }

  /*
   * One word carries the whole idea, so one word carries the accent. It is set
   * in --color-coral-ink rather than --color-coral: this is text on paper, and
   * coral is a fill colour, not a text colour, on a light surface.
   */
  .hero__hot {
    color: var(--color-coral-ink);
  }

  .hero__lede {
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-ink-muted);
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  .hero__figure {
    margin-block-start: var(--space-l);
  }

  .hero__figure :global(img) {
    border-radius: var(--radius-l);
  }

  .stat {
    align-self: end;
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-paper-raised);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      var(--shadow-soft);
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-display-s);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-coral-ink);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
    margin-block-start: var(--space-2xs);
  }

  .bands {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    display: grid;
    gap: var(--space-2xs);
  }

  .bands__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-paper-raised);
    box-shadow: inset 0 0 0 1px var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    transition:
      background-color var(--duration-fast) var(--ease-inout),
      box-shadow var(--duration-fast) var(--ease-inout),
      transform var(--duration-fast) var(--ease-inout);
  }

  @media (width >= 48rem) {
    .bands__link {
      grid-template-columns: 1fr auto auto;
      align-items: baseline;
      gap: var(--space-m);
    }
  }

  .bands__link:hover {
    box-shadow:
      inset 0 0 0 1px var(--color-coral),
      var(--shadow-raised);
    transform: translateY(-2px);
  }

  .bands__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    line-height: 1.2;
    letter-spacing: -0.014em;
  }

  .bands__range {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-m);
    line-height: 1.14;
    letter-spacing: -0.018em;
    color: var(--color-coral-ink);
    min-inline-size: 11ch;
    font-variant-numeric: tabular-nums;
  }

  .bands__weeks {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
    min-inline-size: 10ch;
  }

  .bands__note {
    margin-block-start: var(--space-s);
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
  }

  .link-more {
    margin-block-start: var(--space-s);
    font-weight: var(--font-weight-semibold);
  }

  .stages {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-s);
  }

  .stages__item {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s);
    border-radius: var(--radius-m);
    background: var(--color-paper-raised);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      var(--shadow-soft);
  }

  .stages__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    line-height: 1.2;
    letter-spacing: -0.014em;
  }

  .stages__duration {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
  }

  .stages__item--more {
    background: var(--color-wash-teal);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-teal) 22%, transparent);
    align-content: center;
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    line-height: 1.2;
    letter-spacing: -0.014em;
  }

  .stages__item--more a {
    color: var(--color-teal-ink);
    text-decoration: none;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-m) var(--space-s);
    margin-block-start: var(--space-m);
  }

  .suburbs {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .suburbs a {
    display: inline-block;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-full);
    background: var(--color-paper-raised);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: 1.0625rem;
    letter-spacing: -0.012em;
    text-decoration: none;
    color: var(--color-ink);
    transition:
      background-color var(--duration-fast) var(--ease-inout),
      box-shadow var(--duration-fast) var(--ease-inout);
  }

  .suburbs a:hover {
    background: var(--color-coral);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-coral-ink);
  }
</style>
