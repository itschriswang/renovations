---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Figure from '../components/Figure.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { business } from '../lib/business';
import { href, routes } from '../lib/links';
import { band, weeks } from '../lib/format';
import { localBusinessSchema, websiteSchema } from '../lib/schema';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const bands = business.costBands.bands;
const stages = business.process.stages;
const suburbs = business.serviceArea.suburbs;
---

<Site
  title={`${business.identity.name} — renovation builder, Sydney`}
  description={business.identity.positioning}
  schema={[localBusinessSchema(), websiteSchema()]}
>
  <!-- ================================================================ hero -->
  <section class="hero grid-editorial">
    <div class="col-wide hero__text">
      <p class="hero__eyebrow">
        Kitchens · Bathrooms · Extensions · Whole home renovations
      </p>
      <h1 class="hero__title">Fixed price before demolition starts</h1>
      <p class="hero__lede">
        {business.identity.differentiatorLong}
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={href(routes.contact)}>
          Book a site consultation
        </a>
        <a class="button button--secondary" href={href(routes.estimator)}>
          Work out a rough cost first
        </a>
      </div>
    </div>

    <div class="col-bleed hero__figure">
      <Figure
        id="home-hero-sequence-01"
        alt="A rear extension at dusk with the interior lights on, opening onto a back garden"
        priority
        widths={[640, 1024, 1600, 2560]}
        sizes="100vw"
      />
    </div>
  </section>

  <TrustStrip />

  <!-- ======================================================= what we do -->
  <section class="grid-editorial section">
    <div class="col-text">
      <p class="section__eyebrow">What we do</p>
      <h2 class="section__title">Ordinary Sydney houses, done properly</h2>
      <p class="section__lede">{business.identity.positioning}</p>
    </div>
    <div class="col-aside stat">
      <p class="stat__value" data-numeric>
        {band(business.projectValue.minimum, business.projectValue.maximum)}
      </p>
      <p class="stat__label">
        The range our work falls in. Under {band(business.projectValue.minimum, business.projectValue.minimum)}
        we will point you to someone better suited.
      </p>
    </div>
  </section>

  <!-- ============================================================ costs -->
  <section class="grid-editorial section section--ruled">
    <div class="col-text">
      <p class="section__eyebrow">What it costs</p>
      <h2 class="section__title">The bands our work actually falls in</h2>
      <p class="section__lede">
        Published, not hidden behind a form. Price opacity is the main reason people give up
        on renovating, and a builder who will not talk about money until you are in the room
        is telling you something.
      </p>
    </div>

    <ul class="col-wide bands" role="list">
      {
        bands.map((b) => (
          <li class="bands__item">
            <a class="bands__link" href={`${href(routes.costs)}#${b.id}`}>
              <span class="bands__name">{b.name}</span>
              <span class="bands__range" data-numeric>
                {band(b.low, b.high)}
              </span>
              <span class="bands__weeks" data-numeric>
                {weeks(b.typicalWeeks)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="col-text bands__note">
      GST inclusive. Indicative only — the number that matters is the fixed price quote, and we
      cannot give you that until we have measured the house.
      <a href={href(routes.costs)}>See what moves each band</a>.
    </p>
  </section>

  <!-- ======================================================== approvals -->
  <section class="grid-editorial section section--ruled">
    <div class="col-half">
      <p class="section__eyebrow">Approvals</p>
      <h2 class="section__title">When you need council, and when you do not</h2>
      <p class="section__lede">
        A great deal of work on a standard lot never goes near a council. It is approved by a
        private certifier in weeks under the state codes. Knowing which pathway your block
        qualifies for changes your budget and your timeline more than any other single fact.
      </p>
      <p class="link-more">
        <a href={href(routes.approvals)}>Read the approvals explainer</a>
      </p>
    </div>
    <div class="col-half-end">
      <Figure
        id="approvals-opener"
        alt="A standard suburban lot photographed from the street with the side setbacks visible either side of the house"
        sizes="(min-width: 48rem) 45vw, 92vw"
      />
    </div>
  </section>

  <!-- ========================================================== process -->
  <section class="grid-editorial section section--ruled">
    <div class="col-text">
      <p class="section__eyebrow">How it runs</p>
      <h2 class="section__title">Eleven stages, and what you own at each</h2>
      <p class="section__lede">
        Renovation buyers fear chaos more than cost. Here is the whole sequence, with real
        durations and an explicit note of what is yours to do — because a job stalls on
        decisions far more often than it stalls on trades.
      </p>
    </div>
    <ol class="col-wide stages" role="list">
      {
        stages.slice(0, 6).map((s) => (
          <li class="stages__item">
            <span class="stages__name">{s.name}</span>
            <span class="stages__duration" data-numeric>
              {s.duration}
            </span>
          </li>
        ))
      }
      <li class="stages__item stages__item--more">
        <a href={href(routes.process)}>and five more →</a>
      </li>
    </ol>
  </section>

  <!-- ========================================================= projects -->
  <section class="grid-editorial section section--ruled">
    <div class="col-text">
      <p class="section__eyebrow">Recent work</p>
      <h2 class="section__title">Three jobs, including what went wrong</h2>
      <p class="section__lede">
        Every case study names the constraint, the decision, one honest problem and what it
        cost the client to fix. That last number is nothing in all three, because that is what
        a fixed price contract means.
      </p>
    </div>
    <div class="col-wide projects">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- ========================================================== suburbs -->
  <section class="grid-editorial section section--ruled">
    <div class="col-text">
      <p class="section__eyebrow">Where we work</p>
      <h2 class="section__title">Thirteen suburbs, six councils</h2>
      <p class="section__lede">
        We stay inside an area we can service properly. Each suburb has its own page with the
        housing stock, the council notes and what actually complicates a renovation there.
      </p>
    </div>
    <ul class="col-wide suburbs" role="list">
      {
        suburbs.map((s) => (
          <li>
            <a href={href(routes.suburb(s.slug))}>{s.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <CallToAction />
</Site>

<style>
  .hero {
    padding-block-start: var(--space-l);
    row-gap: var(--space-m);
  }

  .hero__eyebrow {
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink-faint);
  }

  .hero__title {
    font-size: var(--text-display-l);
    line-height: 0.98;
    letter-spacing: -0.006em;
    margin-block: var(--space-2xs) var(--space-s);
    max-width: 14ch;
  }

  .hero__lede {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: var(--measure);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }

  .hero__figure {
    margin-block-start: var(--space-m);
  }

  .stat {
    align-self: end;
    padding-inline-start: var(--space-s);
    border-inline-start: var(--border-rule) solid var(--color-gum);
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-l);
    line-height: 1.08;
    color: var(--color-brick-deep);
  }

  .stat__label {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
    margin-block-start: var(--space-2xs);
  }

  .bands {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    border-block-start: var(--border-hairline) solid var(--color-line);
  }

  .bands__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    border-block-end: var(--border-hairline) solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
  }

  @media (width >= 48rem) {
    .bands__link {
      grid-template-columns: 1fr auto auto;
      align-items: baseline;
      gap: var(--space-m);
    }
  }

  .bands__link:hover {
    background: var(--color-paper-sunk);
  }

  .bands__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display);
    font-size: var(--text-title-s);
    line-height: 1.2;
  }

  .bands__range {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    color: var(--color-brick-deep);
    min-inline-size: 11ch;
  }

  .bands__weeks {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
    min-inline-size: 10ch;
  }

  .bands__note {
    margin-block-start: var(--space-s);
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
  }

  .link-more {
    margin-block-start: var(--space-s);
    font-weight: var(--font-weight-semibold);
  }

  .stages {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-s);
  }

  .stages__item {
    display: grid;
    gap: var(--space-3xs);
    padding-block-start: var(--space-2xs);
    border-block-start: var(--border-rule) solid var(--color-ink);
  }

  .stages__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display);
    font-size: var(--text-title-s);
    line-height: 1.2;
  }

  .stages__duration {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
  }

  .stages__item--more {
    border-block-start-color: var(--color-gum);
    align-content: start;
    font-weight: var(--font-weight-semibold);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-m) var(--space-s);
    margin-block-start: var(--space-m);
  }

  .suburbs {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-m);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, 100%), 1fr));
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--text-body);
  }
</style>
