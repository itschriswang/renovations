---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  /** Sharing image URL. Generated at build time — see src/pages/og/. */
  image?: string;
  imageAlt?: string;
  /** Structured data objects, serialised into one JSON-LD graph. */
  schema?: unknown[];
}

const { title, description, indexable = true, image, imageAlt, schema } = Astro.props;
---

<Base
  title={title}
  description={description}
  indexable={indexable}
  image={image}
  imageAlt={imageAlt}
  schema={schema}
>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>

<script>
  import { initReveals, revealAboveTheFold } from '../scripts/reveal';
  import { initHeroSequence } from '../scripts/hero-sequence';

  initReveals();
  revealAboveTheFold();

  // The hero sequence waits for load so it never competes with LCP, and it
  // checks connection, viewport and motion preference before importing
  // anything. On most visits it imports nothing at all.
  const startSequence = () => {
    void initHeroSequence();
  };
  if (document.readyState === 'complete') startSequence();
  else window.addEventListener('load', startSequence, { once: true });
</script>
