---
import '../styles/app.css';
import { business } from '../lib/business';
import { href } from '../lib/links';

// Imported so the preloads below point at the same content-hashed files the
// stylesheet requests. Hard-coding /fonts/... would preload a URL that does
// not exist once the bundler hashes them, and would break under a base path.
import displayFont from '../assets/fonts/gabarito-variable.woff2?url';
import textFont from '../assets/fonts/schibsted-grotesk-variable.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Set false on internal pages like the style tile. */
  indexable?: boolean;
  /** Absolute or site-relative URL of the sharing image. */
  image?: string;
  imageAlt?: string;
  /** Structured data objects, serialised into one JSON-LD graph. */
  schema?: unknown[];
}

const { title, description, indexable = true, image, imageAlt, schema } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? business.site.url);
const ogImage = image ? new URL(image, canonical).href : undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Both faces are preloaded. They are small enough (32 kB and 41 kB) that
      they arrive before first paint on anything but a poor connection, and
      the metric-matched fallbacks in fonts.css hold the layout steady when
      they do not.
    */}
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.identity.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#f7f3ec" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />

    {
      schema && schema.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
