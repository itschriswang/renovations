---
import { business } from '../lib/business';
import { href, isWithin, primaryNav, routes } from '../lib/links';

/**
 * The mobile menu is a <details> disclosure, so it opens, closes and is
 * keyboard operable with no JavaScript at all. That is the whole reason for
 * the choice: the header is the first thing on every page and it cannot be
 * the thing that breaks when a script fails to load.
 */
const { pathname } = Astro.url;
---

<header class="site-header surface-dark grain">
  <div class="site-header__inner grid-editorial">
    <div class="site-header__bar">
      <a class="wordmark" href={href(routes.home)}>
        <span class="wordmark__name">{business.identity.name}</span>
        <span class="wordmark__descriptor">{business.identity.descriptor}</span>
      </a>

      <details class="nav" name="site-nav">
        <summary class="nav__toggle">
          <span class="nav__toggle-label">Menu</span>
          <span class="nav__toggle-icon" aria-hidden="true"></span>
        </summary>

        <nav class="nav__panel" aria-label="Primary">
          <ul class="nav__list" role="list">
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    class="nav__link"
                    href={href(item.path)}
                    aria-current={isWithin(item.path, pathname) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav__actions">
            <a class="nav__phone" href={`tel:${business.contact.phoneLink}`}>
              {business.contact.phone}
            </a>
            <a class="button button--primary button--small" href={href(routes.contact)}>
              Book a site consultation
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 3px solid var(--color-molten);
  }

  .site-header__bar {
    grid-column: content;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-xs);
  }

  .wordmark {
    display: grid;
    text-decoration: none;
    color: var(--color-paper);
  }

  .wordmark:hover {
    color: var(--color-ochre);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-m);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .wordmark__descriptor {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ochre);
    margin-block-start: 0.15em;
  }

  .nav__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 44px;
    padding-inline: var(--space-2xs);
    cursor: pointer;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    list-style: none;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__toggle-icon {
    inline-size: 1.25rem;
    block-size: 2px;
    background: currentColor;
    box-shadow:
      0 -6px 0 currentColor,
      0 6px 0 currentColor;
  }

  .nav[open] .nav__toggle-icon {
    box-shadow: 0 0 0 currentColor;
  }

  .nav__panel {
    padding-block: var(--space-s);
  }

  .nav__list {
    display: grid;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }

  .nav__link {
    display: block;
    padding-block: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-paper);
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--color-ochre);
  }

  .nav__link[aria-current='page'] {
    color: var(--color-ochre);
    box-shadow: inset 0 -3px 0 var(--color-molten);
  }

  .nav__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid rgb(247 242 231 / 0.22);
  }

  .nav__phone {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display-strong);
    font-size: var(--text-title-s);
    color: var(--color-ochre);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  /* From the medium breakpoint the disclosure is redundant: the links have
     room to sit in the bar, so the toggle is removed from the accessibility
     tree entirely rather than merely hidden. */
  @media (width >= 64rem) {
    .site-header__bar {
      flex-wrap: nowrap;
    }

    .nav__toggle {
      display: none;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: var(--space-m);
    }

    /* The panel is shown whether or not the disclosure is open. A closed
       <details> hides its content, and the toggle that would open it is
       hidden at this width — so without this the navigation would be
       unreachable with JavaScript disabled. */
    .nav:not([open]) > .nav__panel,
    .nav[open] > .nav__panel {
      display: flex;
      align-items: center;
      gap: var(--space-m);
      padding-block: 0;
    }

    .nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-s);
    }

    .nav__link {
      font-family: var(--font-text);
      font-size: var(--text-caption);
      font-weight: var(--font-weight-semibold);
      padding-block: var(--space-2xs);
    }

    .nav__actions {
      margin-block-start: 0;
      padding-block-start: 0;
      border-block-start: none;
    }

    .nav__phone {
      font-size: var(--text-caption);
      font-family: var(--font-text);
      font-weight: var(--font-weight-semibold);
    }
  }
</style>

{/* No script. The disclosure is native, and CSS exposes the panel at widths
    where the toggle is hidden, so the header works with JavaScript off. */}
